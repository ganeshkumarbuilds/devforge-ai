// DevForge AI database schema.
// Provider is SQLite for local development. For production, switch the
// datasource `provider` to "postgresql" and set a proper DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  settings      Json?
  projects      Project[]
  sessions      Session[]
  downloads     Download[]
  conversations Conversation[]
  reviews        CodeReview[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  lastSeen  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Project {
  id          String       @id @default(cuid())
  title       String
  description String
  stack       String
  status             String           @default("completed")
  ownerId            String
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agents             AgentRun[]
  files              ProjectFile[]
  logs               BuildLog[]
  downloads          Download[]
  validationRuns     ValidationRun[]
  versions           ProjectVersion[]
  error              String?
  validated          Boolean          @default(false)
  validationStatus   String           @default("none")
  validationAttempts Int              @default(0)
  validationError    String?
  favorite           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([ownerId, createdAt])
  @@index([status])
}

model AgentRun {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        String
  displayName String     @default("")
  status      String     @default("pending")
  progress    Int        @default(0)
  output      String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  content   String
  language  String   @default("")
  createdAt DateTime @default(now())

  @@unique([projectId, path])
  @@index([projectId])
}

model BuildLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRunId String?
  level      String    @default("info")
  source     String    @default("system")
  message    String
  createdAt  DateTime  @default(now())

  @@index([projectId, createdAt])
}

model Download {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  size      Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model ValidationRun {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempt     Int               @default(1)
  status      String            @default("running")
  error       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  steps       ValidationStep[]

  @@index([projectId, attempt])
}

model ValidationStep {
  id         String        @id @default(cuid())
  runId      String
  run        ValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name       String
  status     String        @default("pending")
  message    String?
  detail     String?
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([runId])
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("New conversation")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model CodeReview {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    String    @default("processing")
  summary   String?
  scores    Json?
  results   Json?
  files     Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   String
  number    Int
  prompt    String
  model     String   @default("")
  summary   String?
  status    String   @default("completed")
  notes     String?
  files     Json?
  logs      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, number])
  @@index([projectId, createdAt])
}
