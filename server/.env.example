# Server configuration
PORT=5000
JWT_SECRET=devforge_super_secret_change_me_in_production
# SQLite (local dev)
DATABASE_URL="file:./devforge.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/devforge?schema=public"

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Storage for generated projects
GENERATED_DIR=./generated
# Maximum token budget for a single agent response
AGENT_MAX_TOKENS=16384

# Live preview (run generated projects in a sandboxed loopback preview)
# PREVIEW_ENABLED=true
# PREVIEW_HOST=127.0.0.1
# PREVIEW_PORT_START=4100
# PREVIEW_PORT_COUNT=500
# PREVIEW_INSTALL_TIMEOUT_MS=300000
# PREVIEW_START_TIMEOUT_MS=120000

# Build Validation Pipeline
# VALIDATION_ENABLED=true
# VALIDATION_MAX_RETRIES=3
# VALIDATION_AI_FIX_ENABLED=true
# VALIDATION_STATIC_ENABLED=true
# VALIDATION_API_CONTRACT_ENABLED=true
# VALIDATION_RUNTIME_ENABLED=true
# VALIDATION_E2E_ENABLED=true
# VALIDATION_COMMAND_TIMEOUT_MS=240000
# VALIDATION_START_TIMEOUT_MS=90000
# VALIDATION_HEALTH_TIMEOUT_MS=10000
# VALIDATION_FRONTEND_HEALTH_TIMEOUT_MS=15000
# VALIDATION_E2E_TIMEOUT_MS=180000
# Maximum repair→validate cycles before surfacing a manual "Validation Failed" report
# VALIDATION_AUTO_REPAIR_MAX_RETRIES=2

# Global OpenRouter request scheduler (free-tier safe defaults)
# Max simultaneous model requests (1-2 recommended for free models)
# OPENROUTER_MAX_CONCURRENCY=1
# Automatic 429/529 retries; 0 = retry indefinitely (never fail a build on a rate limit)
# OPENROUTER_MAX_RETRIES=0
# Exponential backoff bounds for rate-limit retries (Retry-After header is honored when present)
# OPENROUTER_RETRY_BASE_DELAY_MS=1000
# OPENROUTER_RETRY_MAX_DELAY_MS=60000
