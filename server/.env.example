# Server configuration
PORT=5000
JWT_SECRET=devforge_super_secret_change_me_in_production
# SQLite (local dev)
DATABASE_URL="file:./devforge.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/devforge?schema=public"

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Storage for generated projects
GENERATED_DIR=./generated
# Maximum token budget for a single agent response
AGENT_MAX_TOKENS=16384
